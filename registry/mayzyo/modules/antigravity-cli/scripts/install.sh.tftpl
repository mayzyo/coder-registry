#!/bin/bash
set -euo pipefail

command_exists() {
  command -v "$1" > /dev/null 2>&1
}

ARG_INSTALL_ANTIGRAVITY='${ARG_INSTALL_ANTIGRAVITY}'
ARG_ANTIGRAVITY_BINARY_PATH=$(echo -n '${ARG_ANTIGRAVITY_BINARY_PATH}' | base64 -d)
ARG_ANTIGRAVITY_BINARY_PATH="$${ARG_ANTIGRAVITY_BINARY_PATH/#\~/$HOME}"
ARG_ANTIGRAVITY_BINARY_PATH="$${ARG_ANTIGRAVITY_BINARY_PATH//\$HOME/$HOME}"
ARG_WORKDIR=$(echo -n '${ARG_WORKDIR}' | base64 -d)
ARG_SETTINGS_JSON=$(echo -n '${ARG_SETTINGS_JSON}' | base64 -d)
ARG_MCP=$(echo -n '${ARG_MCP}' | base64 -d)

export PATH="$${ARG_ANTIGRAVITY_BINARY_PATH}:$PATH"

SETTINGS_DIR="$HOME/.gemini/antigravity-cli"
CONFIG_DIR="$HOME/.gemini/config"
SETTINGS_FILE="$${SETTINGS_DIR}/settings.json"
MCP_CONFIG_FILE="$${SETTINGS_DIR}/mcp_config.json"

add_path_to_shell_profiles() {
  local path_dir="$1"

  for profile in "$HOME/.profile" "$HOME/.bash_profile" "$HOME/.bashrc" "$HOME/.zprofile" "$HOME/.zshrc"; do
    if [ -f "$${profile}" ] && ! grep -Fq "$${path_dir}" "$${profile}" 2> /dev/null; then
      printf 'export PATH="$PATH:%s"\n' "$${path_dir}" >> "$${profile}"
      echo "Added $${path_dir} to $${profile}"
    fi
  done

  local fish_config="$HOME/.config/fish/config.fish"
  if [ -f "$${fish_config}" ] && ! grep -Fq "$${path_dir}" "$${fish_config}" 2> /dev/null; then
    echo "fish_add_path $${path_dir}" >> "$${fish_config}"
    echo "Added $${path_dir} to $${fish_config}"
  fi
}

ensure_antigravity_in_path() {
  local agy_bin=""
  if command_exists agy; then
    agy_bin=$(command -v agy)
  elif [ -x "$${ARG_ANTIGRAVITY_BINARY_PATH}/agy" ]; then
    agy_bin="$${ARG_ANTIGRAVITY_BINARY_PATH}/agy"
  elif [ -x "$HOME/.local/bin/agy" ]; then
    agy_bin="$HOME/.local/bin/agy"
  fi

  if [ -z "$${agy_bin}" ] || [ ! -x "$${agy_bin}" ]; then
    echo "Error: Could not find agy binary"
    exit 1
  fi

  local agy_dir
  agy_dir=$(dirname "$${agy_bin}")

  if [ -n "$${CODER_SCRIPT_BIN_DIR:-}" ] && [ ! -e "$${CODER_SCRIPT_BIN_DIR}/agy" ]; then
    ln -s "$${agy_bin}" "$${CODER_SCRIPT_BIN_DIR}/agy"
    echo "Created symlink: $${CODER_SCRIPT_BIN_DIR}/agy -> $${agy_bin}"
  fi

  add_path_to_shell_profiles "$${agy_dir}"
}

install_antigravity_cli() {
  if [ "$${ARG_INSTALL_ANTIGRAVITY}" != "true" ]; then
    echo "Skipping Antigravity CLI installation."
    ensure_antigravity_in_path
    return
  fi

  if command_exists agy || [ -x "$${ARG_ANTIGRAVITY_BINARY_PATH}/agy" ] || [ -x "$HOME/.local/bin/agy" ]; then
    echo "Antigravity CLI is already installed. Skipping official installer."
    ensure_antigravity_in_path
    echo "Antigravity CLI version: $(agy --version || echo 'unknown')"
    return
  fi

  echo "Installing Antigravity CLI via official installer"
  if command_exists curl; then
    curl -fsSL --retry 3 --retry-delay 2 --connect-timeout 10 https://antigravity.google/cli/install.sh | bash
  elif command_exists wget; then
    wget -qO- https://antigravity.google/cli/install.sh | bash
  else
    echo "Error: curl or wget is required to install Antigravity CLI."
    exit 1
  fi

  ensure_antigravity_in_path
  echo "Installed Antigravity CLI successfully. Version: $(agy --version || echo 'unknown')"
}

merge_json_to_file() {
  local target_file="$1"
  local new_json="$2"

  if [ ! -f "$${target_file}" ] || [ ! -s "$${target_file}" ]; then
    echo "$${new_json}" > "$${target_file}"
    chmod 600 "$${target_file}"
    return 0
  fi

  local merged=""
  if command_exists jq; then
    merged=$(jq -s '.[0] * .[1]' "$${target_file}" <(echo "$${new_json}") 2>/dev/null) || merged=""
  elif command_exists python3; then
    merged=$(python3 -c "
import json, sys
try:
    with open('$${target_file}', 'r') as f:
        orig = json.load(f)
    new = json.loads('''$${new_json}''')
    def deep_merge(a, b):
        for k, v in b.items():
            if k in a and isinstance(a[k], dict) and isinstance(v, dict):
                deep_merge(a[k], v)
            else:
                a[k] = v
        return a
    print(json.dumps(deep_merge(orig, new), indent=2))
except Exception:
    sys.exit(1)
" 2>/dev/null) || merged=""
  elif command_exists node; then
    merged=$(node -e "
try {
  const fs = require('fs');
  const orig = JSON.parse(fs.readFileSync('$${target_file}', 'utf8'));
  const next = JSON.parse(process.argv[1]);
  function merge(a, b) {
    for (let k of Object.keys(b)) {
      if (a[k] && typeof a[k] === 'object' && !Array.isArray(a[k]) && typeof b[k] === 'object' && !Array.isArray(b[k])) {
        merge(a[k], b[k]);
      } else {
        a[k] = b[k];
      }
    }
    return a;
  }
  console.log(JSON.stringify(merge(orig, next), null, 2));
} catch (e) {
  process.exit(1);
}
" "$${new_json}" 2>/dev/null) || merged=""
  fi

  if [ -n "$${merged}" ]; then
    echo "$${merged}" > "$${target_file}"
  else
    echo "$${new_json}" > "$${target_file}"
  fi
  chmod 600 "$${target_file}"
}

configure_antigravity_cli() {
  mkdir -p "$${SETTINGS_DIR}" "$${CONFIG_DIR}"

  if [ -n "$${ARG_WORKDIR}" ]; then
    mkdir -p "$${ARG_WORKDIR}"
    echo "Prepared Antigravity CLI workdir: $${ARG_WORKDIR}"
  fi

  if [ -n "$${ARG_SETTINGS_JSON}" ]; then
    merge_json_to_file "$${SETTINGS_FILE}" "$${ARG_SETTINGS_JSON}"
    echo "Configured Antigravity CLI settings at $${SETTINGS_FILE}"
  fi

  if [ -n "$${ARG_MCP}" ] && [ "$${ARG_MCP}" != "{}" ]; then
    merge_json_to_file "$${MCP_CONFIG_FILE}" "$${ARG_MCP}"
    echo "Configured Antigravity CLI MCP config at $${MCP_CONFIG_FILE}"
  fi
}

install_antigravity_cli
configure_antigravity_cli
