terraform {
  required_version = ">= 1.9"

  required_providers {
    coder = {
      source  = "coder/coder"
      version = ">= 2.13"
    }
    kubernetes = {
      source  = "hashicorp/kubernetes"
      version = ">= 2.30"
    }
  }
}

variable "agent_id" {
  description = "The ID of a Coder agent."
  type        = string
}

variable "agent_token" {
  description = "The authentication token for the Coder agent."
  type        = string
  sensitive   = true
}

variable "agent_init_script" {
  description = "The init script generated by coder_agent to bootstrap the agent inside the container."
  type        = string
}

variable "container_image" {
  description = "The container image to run for the workspace."
  type        = string
}

variable "container_name" {
  description = "The name of the main workspace container in the pod."
  type        = string
  default     = "dev"
}

variable "home_user" {
  description = "The username inside the container whose home directory is mounted (e.g. node, vscode, coder)."
  type        = string
  default     = "vscode"
}

variable "cpu_request" {
  description = "CPU request for the workspace container."
  type        = string
  default     = "250m"
}

variable "memory_request" {
  description = "Memory request for the workspace container."
  type        = string
  default     = "512Mi"
}

variable "namespace" {
  description = "Kubernetes namespace to deploy the workspace pod and PVC."
  type        = string
  default     = "coder-workspaces"
}

variable "storage_class_name" {
  description = "StorageClass requested for the workspace home PVC."
  type        = string
  default     = "main"
}

variable "host_alias_ip" {
  description = "Optional IP address to add to /etc/hosts in the workspace pod via host_aliases."
  type        = string
  default     = "10.109.67.72"
}

variable "host_alias_hostname" {
  description = "Optional hostname to add to /etc/hosts in the workspace pod via host_aliases."
  type        = string
  default     = "coder.destinesia.studio"
}

variable "security_context_uid" {
  description = "UID and GID to run the container as and chown the volume to."
  type        = number
  default     = 1000
}

variable "pod_labels" {
  description = "Additional labels to attach to the pod."
  type        = map(string)
  default     = {}
}

variable "pod_annotations" {
  description = "Additional annotations to attach to the pod."
  type        = map(string)
  default     = {}
}

# --- Coder Parameters for Workspace Hardware & Storage ---
data "coder_parameter" "cpu_arch" {
  name         = "cpu_arch"
  display_name = "CPU Architecture"
  default      = "x86"
  icon         = "/icon/memory.svg"
  mutable      = true
  option {
    name  = "Any"
    value = "any"
  }
  option {
    name  = "arm64"
    value = "arm64"
  }
  option {
    name  = "x86"
    value = "x86"
  }
}

data "coder_parameter" "cpu" {
  name         = "cpu"
  display_name = "CPU"
  description  = "The number of CPU cores"
  default      = "250m"
  icon         = "/icon/memory.svg"
  mutable      = true
  option {
    name  = "0.2 Cores"
    value = "250m"
  }
  option {
    name  = "0.5 Cores"
    value = "500m"
  }
  option {
    name  = "1 Cores"
    value = "1000m"
  }
  option {
    name  = "2 Cores"
    value = "2000m"
  }
}

data "coder_parameter" "memory" {
  name         = "memory"
  display_name = "Memory"
  description  = "The amount of memory in GB"
  default      = "512Mi"
  icon         = "/icon/memory.svg"
  mutable      = true
  option {
    name  = "0.5 GB"
    value = "512Mi"
  }
  option {
    name  = "1 GB"
    value = "1Gi"
  }
  option {
    name  = "2 GB"
    value = "2Gi"
  }
  option {
    name  = "4 GB"
    value = "4Gi"
  }
}

data "coder_parameter" "home_disk_size" {
  name         = "home_disk_size"
  display_name = "Home disk size"
  description  = "The size of the home disk in GB"
  default      = "0"
  type         = "number"
  icon         = "/emojis/1f4be.png"
  mutable      = false
  validation {
    min = 0
    max = 20
  }
}

data "coder_parameter" "home_disk_workspace" {
  name         = "home_disk_workspace"
  display_name = "Sidecar Workspace Name"
  icon         = "/emojis/1f4be.png"
  type         = "string"
  mutable      = false
  description  = "Sidecar onto the disk of an existing workspace you own (e.g. signal-bus)"
  default      = ""
}

data "coder_workspace" "me" {}
data "coder_workspace_owner" "me" {}

locals {
  create_home_disk = data.coder_parameter.home_disk_size.value != "0" && data.coder_parameter.home_disk_workspace.value == ""
  attach_home_disk = data.coder_parameter.home_disk_workspace.value != ""
  mount_home_disk  = data.coder_parameter.home_disk_size.value != "0" || data.coder_parameter.home_disk_workspace.value != ""

  home_pvc_name    = "coder-${lower(data.coder_workspace_owner.me.name)}-${lower(data.coder_workspace.me.name)}-home"
  sidecar_pvc_name = "coder-${lower(data.coder_workspace_owner.me.name)}-${lower(data.coder_parameter.home_disk_workspace.value)}-home"

  default_labels = {
    "app.kubernetes.io/name"     = "coder-workspace"
    "app.kubernetes.io/instance" = "coder-workspace-${lower(data.coder_workspace_owner.me.name)}-${lower(data.coder_workspace.me.name)}"
    "app.kubernetes.io/part-of"  = "coder"
    "com.coder.resource"         = "true"
    "com.coder.workspace.id"     = data.coder_workspace.me.id
    "com.coder.workspace.name"   = data.coder_workspace.me.name
    "com.coder.user.id"          = data.coder_workspace_owner.me.id
    "com.coder.user.username"    = data.coder_workspace_owner.me.name
  }

  pvc_labels = {
    "app.kubernetes.io/name"     = "coder-pvc"
    "app.kubernetes.io/instance" = "coder-pvc-${lower(data.coder_workspace_owner.me.name)}-${lower(data.coder_workspace.me.name)}"
    "app.kubernetes.io/part-of"  = "coder"
    "com.coder.resource"         = "true"
    "com.coder.workspace.id"     = data.coder_workspace.me.id
    "com.coder.workspace.name"   = data.coder_workspace.me.name
    "com.coder.user.id"          = data.coder_workspace_owner.me.id
    "com.coder.user.username"    = data.coder_workspace_owner.me.name
  }
}

resource "kubernetes_persistent_volume_claim_v1" "home" {
  count = local.create_home_disk ? 1 : 0

  metadata {
    name        = local.home_pvc_name
    namespace   = var.namespace
    labels      = local.pvc_labels
    annotations = {
      "com.coder.user.email" = data.coder_workspace_owner.me.email
    }
  }

  wait_until_bound = true

  spec {
    access_modes       = ["ReadWriteMany"]
    storage_class_name = var.storage_class_name

    resources {
      requests = {
        storage = "${data.coder_parameter.home_disk_size.value}Gi"
      }
    }
  }

  lifecycle {
    ignore_changes = all
  }
}

resource "kubernetes_pod_v1" "main" {
  count = data.coder_workspace.me.start_count

  metadata {
    name        = "coder-${lower(data.coder_workspace_owner.me.name)}-${lower(data.coder_workspace.me.name)}"
    namespace   = var.namespace
    labels      = merge(local.default_labels, var.pod_labels)
    annotations = merge(
      {
        "com.coder.user.email" = data.coder_workspace_owner.me.email
      },
      var.pod_annotations,
    )
  }

  spec {
    security_context {
      run_as_user = var.security_context_uid
      fs_group    = var.security_context_uid
    }

    dynamic "volume" {
      for_each = local.mount_home_disk ? [""] : []

      content {
        name = "home"
        persistent_volume_claim {
          claim_name = local.attach_home_disk ? local.sidecar_pvc_name : try(kubernetes_persistent_volume_claim_v1.home[0].metadata[0].name, "")
          read_only  = false
        }
      }
    }

    dynamic "init_container" {
      for_each = local.create_home_disk ? [""] : []

      content {
        name    = "volume-mount-hack"
        image   = "busybox"
        command = ["sh", "-c", "chown -R ${var.security_context_uid}:${var.security_context_uid} /mountable"]

        security_context {
          run_as_user                = "0"
          allow_privilege_escalation = true
        }

        volume_mount {
          name       = "home"
          mount_path = "/mountable"
        }
      }
    }

    container {
      name    = var.container_name
      image   = var.container_image
      command = ["sh", "-c", var.agent_init_script]

      env {
        name  = "CODER_AGENT_TOKEN"
        value = var.agent_token
      }

      resources {
        requests = {
          "cpu"    = var.cpu_request
          "memory" = var.memory_request
        }
        limits = {
          "cpu"    = "${data.coder_parameter.cpu.value}"
          "memory" = "${data.coder_parameter.memory.value}"
        }
      }

      dynamic "volume_mount" {
        for_each = local.mount_home_disk ? [""] : []

        content {
          name       = "home"
          mount_path = "/home/${var.home_user}"
          read_only  = false
        }
      }
    }

    dynamic "host_aliases" {
      for_each = var.host_alias_ip == "" || var.host_alias_hostname == "" ? [] : [""]

      content {
        ip        = var.host_alias_ip
        hostnames = [var.host_alias_hostname]
      }
    }

    affinity {
      dynamic "node_affinity" {
        for_each = data.coder_parameter.cpu_arch.value == "any" ? [] : [""]

        content {
          required_during_scheduling_ignored_during_execution {
            node_selector_term {
              match_expressions {
                key      = "kubernetes.io/arch"
                operator = data.coder_parameter.cpu_arch.value == "x86" ? "NotIn" : "In"
                values   = ["arm64"]
              }
            }
          }
        }
      }

      pod_anti_affinity {
        preferred_during_scheduling_ignored_during_execution {
          weight = 1
          pod_affinity_term {
            topology_key = "kubernetes.io/hostname"
            label_selector {
              match_expressions {
                key      = "app.kubernetes.io/name"
                operator = "In"
                values   = ["coder-workspace"]
              }
            }
          }
        }
      }
    }
  }
}

output "arch" {
  description = "Target Coder agent architecture derived from the cpu_arch parameter (amd64 or arm64)."
  value       = data.coder_parameter.cpu_arch.value == "x86" ? "amd64" : "arm64"
}

output "pod_name" {
  description = "The name of the provisioned Kubernetes workspace pod."
  value       = try(kubernetes_pod_v1.main[0].metadata[0].name, "")
}

output "pvc_name" {
  description = "The name of the persistent volume claim attached to the workspace home."
  value       = local.create_home_disk ? try(kubernetes_persistent_volume_claim_v1.home[0].metadata[0].name, "") : (local.attach_home_disk ? local.sidecar_pvc_name : "")
}

output "home_dir" {
  description = "The mounted home directory path inside the container."
  value       = "/home/${var.home_user}"
}
